{
  "$schema": "https://railway.com/railway.schema.json",
  "_comment": [
    "Celery worker. HTTP-порта не открывает — healthcheck и домен ему не нужны,",
    "Railway такие сервисы не убивает.",
    "concurrency=2: pipeline упирается в сеть (Groq, GitHub), а не в CPU."
  ],
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": ["backend/**"]
  },
  "deploy": {
    "startCommand": "celery -A app.tasks.celery_app worker --loglevel=info --concurrency=2 --max-tasks-per-child=200",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
