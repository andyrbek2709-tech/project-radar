# =============================================================================
# Project Radar — переменные окружения
#
# Скопируй в .env и заполни. Файл .env в git не попадает (см. .gitignore).
# Секреты хранятся ТОЛЬКО здесь: в коде и в таблице settings их нет.
# =============================================================================

# ----------------------------------------------------------------- APP -----
APP_NAME=Project Radar
APP_ENV=local                       # local | staging | production
APP_URL=http://localhost:8000
SECRET_KEY=                         # любая длинная случайная строка
TIMEZONE=Asia/Aqtau
LOG_LEVEL=INFO
LOG_JSON=true                       # false = читаемый вывод при локальной разработке

# --------------------------------------------------------------- INFRA -----
# Локально через docker-compose подставляется автоматически.
# На Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/radar
# На Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------ TELEGRAM -----
# USER SESSION, не Bot API. api_id/api_hash: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Генерируется ЛОКАЛЬНО и один раз:
#   cd backend && python scripts/gen_telegram_session.py
# Строка = полный доступ к аккаунту. В git не коммитить, никому не показывать.
TELEGRAM_SESSION_STRING=

# Каналы и группы через запятую. Надёжнее численные -100… id.
# Получить id из @username: python scripts/resolve_telegram_ids.py @channel
TELEGRAM_SOURCE_IDS=

TELEGRAM_ENABLED=true
TELEGRAM_HISTORY_LIMIT=50           # сколько сообщений забирать за проход
TELEGRAM_FLOOD_SLEEP_THRESHOLD=60   # до скольких секунд Telethon ждёт сам
TELEGRAM_DELIVER_REPORT=true        # слать Daily Radar себе в «Избранное»

# -------------------------------------------------------------- GITHUB -----
# Classic PAT или fine-grained. Нужны только read-права на публичные репы;
# для техревизии ПРИВАТНЫХ репозиториев проектов — доступ на чтение к ним.
GITHUB_TOKEN=
GITHUB_USERNAME=andyrbek2709-tech
GITHUB_SEARCH_ENABLED=true
GITHUB_MIN_STARS=40                 # порог дешёвого фильтра
GITHUB_MAX_REPO_AGE_DAYS=30         # окно «новых» репозиториев
GITHUB_STALE_PUSH_DAYS=270          # старше — считаем заброшенным
GITHUB_README_MAX_CHARS=12000

# ---------------------------------------------------------------- GROQ -----
# Первый дешёвый массовый слой. Строгий JSON-схемой режим поддерживают
# ТОЛЬКО openai/gpt-oss-20b и openai/gpt-oss-120b — не меняй модель на
# другую, не проверив, что strict у неё работает.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ESCALATION_MODEL=openai/gpt-oss-120b
GROQ_ENABLED=true
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_TIMEOUT_SECONDS=60

# -------------------------------------------------------------- OPENAI -----
# Deep analysis. По умолчанию ВЫКЛЮЧЕН: разбор идёт вручную через
# кнопку COPY ANALYSIS CONTEXT, ответ вставляется обратно в систему.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_DEEP_ANALYSIS_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------- EMBEDDINGS -----
# У Groq эмбеддингов нет — нужен отдельный провайдер.
#   openai — text-embedding-3-small, 1536, $0.02/1M, ноль RAM
#   local  — sentence-transformers, требует раскомментировать зависимость
#            в requirements.txt и ~2 GB RAM
#   null   — детерминированная заглушка: pipeline работает без ключей,
#            но семантическая дедупликация бесполезна
#
# ВНИМАНИЕ: EMBEDDING_DIM фиксируется в миграции. Менять после первого
# `alembic upgrade head` нельзя без пересчёта всех векторов.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

# --------------------------------------------------------------- RADAR -----
RADAR_ENABLED=true
RADAR_DAILY_TIME=21:00
RADAR_TIMEZONE=Asia/Aqtau
TELEGRAM_SCAN_INTERVAL_MINUTES=15
GITHUB_SCAN_INTERVAL_MINUTES=120
PIPELINE_INTERVAL_MINUTES=10

MAX_DEEP_ANALYSES_PER_DAY=20
PIPELINE_BATCH_SIZE=120

# Пороги. Стартовые значения строгие: короткие и часто пустые отчёты
# первые недели — это признак работающего фильтра, а не поломки.
# Менять можно на лету через PUT /api/settings/{key}, без редеплоя.
MIN_RELEVANCE_SCORE=0.65
MIN_DEEP_ANALYSIS_SCORE=0.70
CRITICAL_SCORE=0.80
RECOMMENDED_SCORE=0.60
REVIEW_LATER_SCORE=0.40
DEDUP_COSINE_THRESHOLD=0.08         # косинусное РАССТОЯНИЕ, меньше = строже
DUPLICATE_FEATURE_THRESHOLD=0.85    # похожесть на существующую фичу → дубль

# ------------------------------------------------------------- WEB/API -----
# На Railway: https://<frontend>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
# Внутренний адрес backend для прокси Next.js.
# На Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8000 (см. docs/RAILWAY_VARIABLES.md)
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
